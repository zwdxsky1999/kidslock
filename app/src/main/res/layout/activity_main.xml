<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/settings_bg"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/tv_margin_h"
        android:gravity="center_horizontal">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/settings_title"
            android:textColor="@color/accent"
            android:textSize="@dimen/text_title"
            android:textStyle="bold"
            android:layout_marginBottom="@dimen/spacing_medium" />

        <TextView
            android:id="@+id/tvStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/text_primary"
            android:textSize="@dimen/text_subtitle"
            android:layout_marginBottom="@dimen/spacing_small" />

        <TextView
            android:id="@+id/tvRemaining"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/highlight"
            android:textSize="@dimen/text_body"
            android:layout_marginBottom="@dimen/spacing_large" />

        <!-- ===== 运行模式 ===== -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="运行模式"
            android:textColor="@color/highlight"
            android:textSize="@dimen/text_subtitle"
            android:layout_marginBottom="@dimen/spacing_small" />

        <TextView
            android:id="@+id/tvMode"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/text_primary"
            android:textSize="@dimen/text_body"
            android:layout_marginBottom="@dimen/spacing_small" />

        <Button
            android:id="@+id/btnModeToggle"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/btn_height"
            android:layout_marginBottom="@dimen/spacing_medium"
            android:minWidth="300dp"
            android:text="切换模式"
            android:textSize="@dimen/text_button"
            android:background="@drawable/btn_settings_bg"
            android:textColor="@color/btn_text"
            android:focusable="true"
            android:clickable="true" />

        <!-- ===== 孩子信息 ===== -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="孩子信息（按此出题）"
            android:textColor="@color/highlight"
            android:textSize="@dimen/text_subtitle"
            android:layout_marginTop="@dimen/spacing_large"
            android:layout_marginBottom="@dimen/spacing_small" />

        <TextView
            android:id="@+id/tvGrade"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/text_primary"
            android:textSize="@dimen/text_body"
            android:layout_marginBottom="@dimen/spacing_small" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="@dimen/spacing_small">

            <Button android:id="@+id/btnGradeDown"
                android:layout_width="wrap_content" android:layout_height="@dimen/btn_height"
                android:layout_margin="@dimen/btn_margin" android:minWidth="80dp"
                android:text="− 降年级"
                android:textSize="@dimen/text_body"
                android:background="@drawable/btn_settings_bg"
                android:textColor="@color/btn_text"
                android:focusable="true" android:clickable="true" />
            <Button android:id="@+id/btnGradeUp"
                android:layout_width="wrap_content" android:layout_height="@dimen/btn_height"
                android:layout_margin="@dimen/btn_margin" android:minWidth="80dp"
                android:text="升年级 +"
                android:textSize="@dimen/text_body"
                android:background="@drawable/btn_settings_bg"
                android:textColor="@color/btn_text"
                android:focusable="true" android:clickable="true" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvSubjects"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/text_secondary"
            android:textSize="@dimen/text_body"
            android:layout_marginBottom="@dimen/spacing_medium" />

        <!-- ===== 出题设置 ===== -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="出题设置"
            android:textColor="@color/highlight"
            android:textSize="@dimen/text_subtitle"
            android:layout_marginTop="@dimen/spacing_large"
            android:layout_marginBottom="@dimen/spacing_small" />

        <TextView
            android:id="@+id/tvInterval"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/text_primary"
            android:textSize="@dimen/text_body"
            android:layout_marginBottom="@dimen/spacing_small" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="@dimen/spacing_medium">

            <Button android:id="@+id/btnInt3"
                android:layout_width="wrap_content" android:layout_height="@dimen/btn_height"
                android:layout_margin="@dimen/btn_margin" android:minWidth="70dp"
                android:text="3分" android:textSize="@dimen/text_body"
                android:background="@drawable/btn_settings_bg" android:textColor="@color/btn_text"
                android:focusable="true" android:clickable="true" />
            <Button android:id="@+id/btnInt5"
                android:layout_width="wrap_content" android:layout_height="@dimen/btn_height"
                android:layout_margin="@dimen/btn_margin" android:minWidth="70dp"
                android:text="5分" android:textSize="@dimen/text_body"
                android:background="@drawable/btn_settings_bg" android:textColor="@color/btn_text"
                android:focusable="true" android:clickable="true" />
            <Button android:id="@+id/btnInt10"
                android:layout_width="wrap_content" android:layout_height="@dimen/btn_height"
                android:layout_margin="@dimen/btn_margin" android:minWidth="70dp"
                android:text="10分" android:textSize="@dimen/text_body"
                android:background="@drawable/btn_settings_bg" android:textColor="@color/btn_text"
                android:focusable="true" android:clickable="true" />
            <Button android:id="@+id/btnInt15"
                android:layout_width="wrap_content" android:layout_height="@dimen/btn_height"
                android:layout_margin="@dimen/btn_margin" android:minWidth="70dp"
                android:text="15分" android:textSize="@dimen/text_body"
                android:background="@drawable/btn_settings_bg" android:textColor="@color/btn_text"
                android:focusable="true" android:clickable="true" />
            <Button android:id="@+id/btnInt20"
                android:layout_width="wrap_content" android:layout_height="@dimen/btn_height"
                android:layout_margin="@dimen/btn_margin" android:minWidth="70dp"
                android:text="20分" android:textSize="@dimen/text_body"
                android:background="@drawable/btn_settings_bg" android:textColor="@color/btn_text"
                android:focusable="true" android:clickable="true" />
            <Button android:id="@+id/btnInt25"
                android:layout_width="wrap_content" android:layout_height="@dimen/btn_height"
                android:layout_margin="@dimen/btn_margin" android:minWidth="70dp"
                android:text="25分" android:textSize="@dimen/text_body"
                android:background="@drawable/btn_settings_bg" android:textColor="@color/btn_text"
                android:focusable="true" android:clickable="true" />
            <Button android:id="@+id/btnInt1"
                android:layout_width="wrap_content" android:layout_height="@dimen/btn_height"
                android:layout_margin="@dimen/btn_margin" android:minWidth="70dp"
                android:text="1分" android:textSize="@dimen/text_body"
                android:background="@drawable/btn_settings_bg" android:textColor="@color/btn_text"
                android:focusable="true" android:clickable="true" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvUnlockCount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/text_primary"
            android:textSize="@dimen/text_body"
            android:layout_marginBottom="@dimen/spacing_small" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="@dimen/spacing_medium">

            <Button android:id="@+id/btnUnlock3"
                android:layout_width="wrap_content" android:layout_height="@dimen/btn_height"
                android:layout_margin="@dimen/btn_margin" android:minWidth="80dp"
                android:text="3题" android:textSize="@dimen/text_body"
                android:background="@drawable/btn_settings_bg" android:textColor="@color/btn_text"
                android:focusable="true" android:clickable="true" />
            <Button android:id="@+id/btnUnlock5"
                android:layout_width="wrap_content" android:layout_height="@dimen/btn_height"
                android:layout_margin="@dimen/btn_margin" android:minWidth="80dp"
                android:text="5题" android:textSize="@dimen/text_body"
                android:background="@drawable/btn_settings_bg" android:textColor="@color/btn_text"
                android:focusable="true" android:clickable="true" />
            <Button android:id="@+id/btnUnlock10"
                android:layout_width="wrap_content" android:layout_height="@dimen/btn_height"
                android:layout_margin="@dimen/btn_margin" android:minWidth="80dp"
                android:text="10题" android:textSize="@dimen/text_body"
                android:background="@drawable/btn_settings_bg" android:textColor="@color/btn_text"
                android:focusable="true" android:clickable="true" />
        </LinearLayout>

        <!-- ===== 在线题库（可选） ===== -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="在线题库（可选，需 NAS 后台）"
            android:textColor="@color/highlight"
            android:textSize="@dimen/text_subtitle"
            android:layout_marginTop="@dimen/spacing_large"
            android:layout_marginBottom="@dimen/spacing_small" />

        <TextView
            android:id="@+id/tvOnline"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/text_secondary"
            android:textSize="@dimen/text_body"
            android:gravity="center"
            android:layout_marginBottom="@dimen/spacing_small" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="@dimen/spacing_medium">

            <Button android:id="@+id/btnConfigOnline"
                android:layout_width="wrap_content" android:layout_height="@dimen/btn_height"
                android:layout_margin="@dimen/btn_margin" android:minWidth="180dp"
                android:text="配置服务器/孩子ID"
                android:textSize="@dimen/text_body"
                android:background="@drawable/btn_settings_bg" android:textColor="@color/btn_text"
                android:focusable="true" android:clickable="true" />
            <Button android:id="@+id/btnToggleOnline"
                android:layout_width="wrap_content" android:layout_height="@dimen/btn_height"
                android:layout_margin="@dimen/btn_margin" android:minWidth="160dp"
                android:text="开启/关闭联网"
                android:textSize="@dimen/text_body"
                android:background="@drawable/btn_settings_bg" android:textColor="@color/btn_text"
                android:focusable="true" android:clickable="true" />
        </LinearLayout>

        <!-- ===== 家长 PIN ===== -->
        <Button
            android:id="@+id/btnSetPin"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/btn_height"
            android:layout_marginTop="@dimen/spacing_medium"
            android:minWidth="300dp"
            android:text="@string/btn_set_pin"
            android:textSize="@dimen/text_button"
            android:background="@drawable/btn_settings_bg"
            android:textColor="@color/btn_text"
            android:focusable="true"
            android:clickable="true" />

        <!-- ===== 操作 ===== -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="操作"
            android:textColor="@color/highlight"
            android:textSize="@dimen/text_subtitle"
            android:layout_marginTop="@dimen/spacing_large"
            android:layout_marginBottom="@dimen/spacing_small" />

        <Button
            android:id="@+id/btnEnableChild"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/btn_height"
            android:layout_margin="@dimen/btn_margin"
            android:minWidth="300dp"
            android:text="开启孩子模式（立即锁屏）"
            android:textSize="@dimen/text_button"
            android:background="@drawable/btn_settings_bg"
            android:textColor="@color/btn_text"
            android:focusable="true"
            android:clickable="true" />

        <Button
            android:id="@+id/btnEnableParent"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/btn_height"
            android:layout_margin="@dimen/btn_margin"
            android:minWidth="300dp"
            android:text="切换到家长模式（解锁）"
            android:textSize="@dimen/text_button"
            android:background="@drawable/btn_settings_bg"
            android:textColor="@color/btn_text"
            android:focusable="true"
            android:clickable="true" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="默认PIN码：1234，请尽快修改\n家长解锁后将切换到家长模式（不再弹题）"
            android:textColor="@color/text_secondary"
            android:textSize="@dimen/text_body"
            android:gravity="center"
            android:layout_marginTop="@dimen/spacing_large"
            android:lineSpacingExtra="4dp" />

    </LinearLayout>
</ScrollView>
